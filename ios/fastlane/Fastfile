default_platform(:ios)

platform :ios do
  desc "Set up App Store Connect API Key"
  def setup_api_key
    key_id = ENV["APP_STORE_CONNECT_KEY_ID"] || "QL949TT83P"
    issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_PRIVATE_KEY"]

    # Check local key file if key_content is not set in ENV
    local_key_file = "/home/osama/Desktop/Systm-Gulf/ios_credentials/AuthKey_#{key_id}.p8"
    key_filepath = nil
    if (!key_content || key_content.strip.empty?) && File.exist?(local_key_file)
      key_filepath = local_key_file
    end

    if key_id && issuer_id && (key_content || key_filepath)
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: (key_content && !key_content.strip.empty?) ? key_content : nil,
        key_filepath: key_filepath,
        is_key_content_base64: false,
        in_house: false
      )
    else
      UI.important("Notice: APP_STORE_CONNECT_ISSUER_ID or PRIVATE_KEY not found in ENV; fastlane will prompt or use Apple ID.")
      nil
    end
  end

  desc "Build and upload iOS IPA to TestFlight"
  lane :beta do |options|
    api_key = setup_api_key
    build_number = options[:build_number]

    root_dir = File.expand_path("../..", __dir__)
    unless options[:skip_build]
      build_flag = build_number ? "--build-number=#{build_number}" : ""
      sh("cd '#{root_dir}' && flutter build ipa --release #{build_flag} --export-options-plist=ios/ExportOptions.plist")
    end

    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipa_path = Dir["#{ipa_dir}/*.ipa"].first
    UI.user_error!("No IPA found in #{ipa_dir}") unless ipa_path && File.exist?(ipa_path)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload iOS IPA to App Store Connect for distribution"
  lane :distribute do |options|
    api_key = setup_api_key
    build_number = options[:build_number]

    root_dir = File.expand_path("../..", __dir__)
    unless options[:skip_build]
      build_flag = build_number ? "--build-number=#{build_number}" : ""
      sh("cd '#{root_dir}' && flutter build ipa --release #{build_flag} --export-options-plist=ios/ExportOptions.plist")
    end

    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipa_path = Dir["#{ipa_dir}/*.ipa"].first
    UI.user_error!("No IPA found in #{ipa_dir}") unless ipa_path && File.exist?(ipa_path)

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: options[:skip_metadata] || false,
      skip_screenshots: options[:skip_screenshots] || false,
      force: true,
      automatic_release: false
    )
  end

  desc "Upload metadata and screenshots to App Store Connect without uploading binary"
  lane :upload_metadata do
    api_key = setup_api_key

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      force: true,
      overwrite_screenshots: true
    )
  end
end
